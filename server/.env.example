# --- Required ---------------------------------------------------------------
MONGOURL=mongodb://localhost:27017/chatter
# Firebase service account (Project settings → Service accounts → Generate key).
# Keep the private key on one line with literal \n sequences.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Signs time-limited media URLs. Required in production; at least 32 characters.
MEDIA_URL_SECRET=change-me-to-a-long-random-string-of-32+-chars

# --- Optional ---------------------------------------------------------------
PORT=8000
NODE_ENV=development
# Comma-separated browser origins allowed to call the API and open sockets.
CLIENT_ORIGINS=http://localhost:3000
# Number of reverse proxies in front of the app (1 on Render/Heroku), for correct client IPs.
TRUST_PROXY=0
LOG_LEVEL=info
# Where uploaded media is stored. Use a persistent disk in production (e.g. a Render disk mount).
UPLOAD_DIR=uploads
MEDIA_URL_TTL_SECONDS=21600

# Voice/video calls (ZEGOCLOUD). Calls are disabled when unset.
# ZEGO_SERVER_SECRET is the 32-char "ServerSecret" from the ZEGOCLOUD console — never expose it to the client.
ZEGO_APP_ID=
ZEGO_SERVER_SECRET=
# Optional explicit signalling server URL handed to the web client.
ZEGO_SERVER_URL=

# Limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_UPLOAD_MAX=30
SOCKET_EVENTS_PER_10S=60
MESSAGE_MAX_LENGTH=4000
MESSAGE_EDIT_WINDOW_MINUTES=15
MESSAGE_DELETE_WINDOW_MINUTES=60
CALL_RING_TIMEOUT_SECONDS=30
GROUP_MAX_MEMBERS=256
